#include <iostream>
#include <cstdlib>
using namespace std ; 
int readNumber ()
{ 
int number ; 
cout << "Enter a Number of Array : ";
cin >> number  ; 
return number ;  
}
void fillArray (int arr [], int number ) 
{
for (int i =0 ; i < number ; i++) 
   {
     arr [i] = rand()%100 ; 
   }
}
void printArray (int arr [], int number ) 
{
    for (int i =0 ; i < number ; i++) 

    {
    cout << arr[i] <<endl; 
    }
}
void printReservedArray (int arr [], int number ) 
{
    for (int i =number-1; i >=0 ; i--) 

    {
    cout << arr[i] <<endl; 
    }
}

int main (){
    srand ((unsigned)time(NULL)) ; 
int number = readNumber(); 
int arr [100]; 
fillArray(arr , number ) ;  
printArray (arr , number ) ; 

cout<< "*********************************"<<endl  ; 
printReservedArray ( arr , number );

    return 0 ; 
}



