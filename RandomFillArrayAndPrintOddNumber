{
  for (int i = 0 ; i<number ; i++)
   {
     cout << "The number   "<< (i+1) <<"   =   "<<  arr [i]  << endl  ; 
   }
}
void checkOddArrayNumber(int arr[] , int oddArr [] ,int &len ,int number  )
{
    for (int i = 0 ; i<number ; i++)
    {
       if (arr[i]%2!=0)
       {
         oddArr[len]= arr[i] ; 
         len++ ; 

       }
    }
}
